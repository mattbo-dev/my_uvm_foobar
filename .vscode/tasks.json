{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Calculator: Build",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BUILD_MODE": "normal",
                    "SIM_THREADS": "4"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Calculator: Directed",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BUILD_MODE": "normal",
                    "SIM_THREADS": "4",
                    "UVM_TEST": "calc_directed_test",
                    "UVM_VERBOSITY": "UVM_MEDIUM"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Calculator: Random Seed 42",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BUILD_MODE": "normal",
                    "SIM_THREADS": "4",
                    "UVM_TEST": "calc_random_test",
                    "SEED": "42",
                    "NUM_TRANSACTIONS": "150",
                    "UVM_VERBOSITY": "UVM_MEDIUM"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Calculator: Backpressure",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BUILD_MODE": "normal",
                    "SIM_THREADS": "4",
                    "UVM_TEST": "calc_backpressure_test"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Calculator: Reset",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BUILD_MODE": "normal",
                    "SIM_THREADS": "4",
                    "UVM_TEST": "calc_reset_test"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Calculator: All",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BUILD_MODE": "normal",
                    "SIM_THREADS": "4",
                    "UVM_TEST": "calc_all_test"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Calculator: Clean Build",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/build.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BUILD_MODE": "normal",
                    "SIM_THREADS": "4",
                    "CLEAN_BUILD": "1"
                }
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "Calculator: Regression",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/regression.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BUILD_MODE": "normal",
                    "SIM_THREADS": "4"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Calculator: Coverage Report",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/coverage_report.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "BUILD_MODE": "normal",
                    "SIM_THREADS": "4"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Calculator: Open GTKWave",
            "type": "shell",
            "command": "gtkwave",
            "args": ["${workspaceFolder}/sim/waves.fst"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Calculator: Clean Generated Output",
            "type": "shell",
            "command": "find",
            "args": ["${workspaceFolder}/sim", "-mindepth", "1", "-maxdepth", "1", "-exec", "rm", "-rf", "{}", "+"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
